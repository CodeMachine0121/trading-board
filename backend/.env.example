# Copy to .env for local runs. Every value has a default except the secrets.
# CORS_ALLOWED_ORIGINS also decides which origins may use the refresh-token cookie (renewal and sign-out).
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=trading_board
POSTGRES_SSL_MODE=disable

# Secrets (Kubernetes Secret in the cluster). An empty owner email or password hash admits nobody.
# OWNER_PASSWORD_HASH is a bcrypt hash, never the password itself; make one with:
#   read -rs PASSWORD && printf '%s' "$PASSWORD" | go run ./cmd/hash-password; unset PASSWORD
# Quote it in this file ('$2a$10$...') so nothing expands the dollar signs.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
AUTH_ACCESS_TOKEN_SIGNING_KEY=

# OAuth 2.0 (authorization code + PKCE) for the one web client. Redirect URIs are comma-separated and must match exactly.
OAUTH_CLIENT_ID=trading-board-web
OAUTH_REDIRECT_URIS=http://localhost:3000/auth/callback
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=15
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30
AUTH_AUTHORIZATION_CODE_LIFETIME_SECONDS=60

# Refresh-token cookie (HttpOnly, SameSite=Strict, path /api/v1/oauth). Empty domain = the API host only.
# Keep SECURE=true everywhere served over https; local http development may need false.
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SECURE=true

# Fee estimate used when a fill is reported without a fee.
FEE_BROKER_RATE=0.001425
FEE_DISCOUNT=0.6
FEE_MINIMUM=1
FEE_TRANSACTION_TAX_RATE=0.003

BUDGET_MONTHLY_ALLOCATION=10000
BUDGET_MONTH_END_START_DAY=22
BUSINESS_TIME_ZONE=Asia/Taipei
